#!/usr/bin/python3
# Filtro CUPS (v3): entrega o PostScript da Xerox para a impressora e grava a
# contabilidade (usuario, cor, paginas, lados) em um log proprio.
# Filas listadas em GRUPOS_COR: quem NAO estiver no grupo indicado tem o job
# convertido para P&B (troca do valor de color-effects-type no cabecalho XPIF).
# Filas listadas em FILAS_PIN: job sem PIN e rejeitado em silencio (so registrado).
#
# Instalar em /usr/lib/cups/filter/xerox-contagem (root:root, modo 755).
# Veja docs/02-filtro-de-contagem.md.
import sys, re, os, time, subprocess

LOG = "/var/log/cups-contabilidade/contagem-%s.log"
LIMITE = 65536
GRUPOS_COR = {
    "adm-xerox": "impressora_adm_xerox_cor",
}
FILAS_PIN = {"adm-xerox"}
RE_COR = re.compile(rb'(<color-effects-type[^>]*>)color(</color-effects-type>)')

def pega(tag, texto):
    m = re.search(r'<%s(?:\s[^>]*)?>([^<]*)</%s>' % (tag, tag), texto)
    return m.group(1).strip() if m else "?"

def no_grupo(user, grupo):
    # True/False; None se a consulta falhar
    try:
        r = subprocess.run(["id", "-nG", user], capture_output=True, text=True, timeout=10)
        if r.returncode != 0:
            return None
        return grupo in [g.lower() for g in r.stdout.split()]
    except Exception:
        return None

def pin_status(head):
    m = re.search(rb"<job-password(?:\s[^>]*)?>([^<]*)</job-password>", head)
    if m:
        return "sim" if m.group(1).strip() else "vazio"
    return "ausente"

def registrar(job, user, title, enviado, tail, pedida, nota, pin):
    h = enviado.decode("latin-1")
    t = tail.decode("latin-1")
    cor = pega("color-effects-type", h)
    lados = pega("sides", h)
    copias = pega("copies", h)
    pags = re.findall(r'^%%Pages:\s*(\d+)', t, re.M)
    paginas = pags[-1] if pags else "?"
    fila = os.environ.get("PRINTER", "?")
    agora = time.strftime("%Y-%m-%d %H:%M:%S")
    titulo = title.replace("\t", " ").replace("\n", " ")
    campos = [agora, fila, job, user, paginas, copias, lados, cor, titulo, pedida, nota, pin]
    with open(LOG % agora[:7], "a", encoding="utf-8", errors="replace") as f:
        f.write("\t".join(campos) + "\n")

def main():
    a = sys.argv
    job = a[1] if len(a) > 1 else "0"
    user = a[2] if len(a) > 2 else "?"
    title = a[3] if len(a) > 3 else ""
    src = open(a[6], "rb") if len(a) > 6 else sys.stdin.buffer
    out = sys.stdout.buffer
    fila = os.environ.get("PRINTER", "?")

    head = b""
    while len(head) < LIMITE:
        chunk = src.read(LIMITE - len(head))
        if not chunk:
            break
        head += chunk

    enviado = head
    pedida = "?"
    nota = "ok"
    pin = "?"
    try:
        pedida = pega("color-effects-type", head.decode("latin-1"))
        pin = pin_status(head)
        grupo = GRUPOS_COR.get(fila)
        if grupo and pedida == "color":
            ok = no_grupo(user, grupo)
            if ok is not True:
                enviado, n = RE_COR.subn(rb'\1monochrome-grayscale\2', head, count=1)
                nota = "forcado-pb" if ok is False else "forcado-pb-erro-grupos"
                if n == 0:
                    nota = "FALHA-forcar-pb"
    except Exception as e:
        enviado = head
        nota = "erro-filtro"
        sys.stderr.write("DEBUG: controle de cor falhou: %s\n" % e)

    if fila in FILAS_PIN and pin in ("ausente", "vazio"):
        try:
            registrar(job, user, title, head, b"", pedida, "rejeitado-sem-pin", pin)
        except Exception as e:
            sys.stderr.write("DEBUG: registro da rejeicao falhou: %s\n" % e)
        sys.stderr.write("INFO: job %s de %s rejeitado: sem PIN\n" % (job, user))
        sys.exit(0)

    out.write(enviado)
    tail = head
    while True:
        chunk = src.read(65536)
        if not chunk:
            break
        out.write(chunk)
        tail = (tail + chunk)[-LIMITE:]
    out.flush()
    try:
        registrar(job, user, title, enviado, tail, pedida, nota, pin)
    except Exception as e:
        sys.stderr.write("DEBUG: contagem falhou: %s\n" % e)

main()
