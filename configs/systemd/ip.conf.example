# Salvar como /etc/systemd/system/<nome-do-socket>.socket.d/ip.conf
# Exemplos: cups-recebe-adm-xerox.socket.d/ip.conf e cups-recebe-faturamento-hp.socket.d/ip.conf
# Todo receptor de porta TCP novo precisa deste mesmo drop-in (um por socket).
# Restringe quem pode conectar na porta do receptor (sub-redes de exemplo).
[Socket]
IPAddressDeny=any
IPAddressAllow=192.0.2.0/24 198.51.100.0/24 203.0.113.0/24
